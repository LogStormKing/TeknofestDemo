<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1F22"
    android:gravity="center"
    android:padding="24dp">

    <!-- ÜST LOGO VE BAŞLIK -->


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPENGW SİSTEMİ"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <!-- GİRİŞ KUTUSU (VERIFY YOUR NUMBER KARTI) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#2B2D31">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFY YOUR NUMBER"
                android:textColor="#B5BAC1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Telefon Numarası (MSISDN) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#111214"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/editPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="MSISDN"
                    android:text="+905390000020"
                    android:inputType="phone"
                    android:textColorHint="#5C5E66"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"/>
            </androidx.cardview.widget.CardView>

            <!-- Giriş Butonu -->
            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Sign in"
                android:textAllCaps="false"
                android:backgroundTint="#5865F2"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <!-- HATA BÖLÜMÜ (BAŞLANGIÇTA GİZLİ) -->
            <LinearLayout
                android:id="@+id/errorSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign-in failed"
                    android:textColor="#ED4245"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- CONNECTION LOGS KARTI (GENİŞLETİLEBİLİR) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#111214">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Log Başlığı (Tıklanabilir) -->
                        <LinearLayout
                            android:id="@+id/btnToggleLogs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Connection logs"
                                android:textColor="#949BA4"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/iconExpand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▼"
                                android:textColor="#949BA4"
                                android:textSize="10sp"/>
                        </LinearLayout>

                        <!-- Log İçeriği (Başlangıçta Gizli) -->
                        <TextView
                            android:id="@+id/textLogDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:background="#000000"
                            android:textColor="#ED4245"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:text="POST /verify\n{\n  &quot;devicePhoneNumberVerified&quot;: false,\n  &quot;status&quot;: &quot;UNAUTHORIZED&quot;,\n  &quot;reason&quot;: &quot;Mobil ağ üzerinden numara eşleşmedi.&quot;\n}"
                            android:visibility="gone"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>