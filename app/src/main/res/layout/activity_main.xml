<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#F0F2F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VERIFY YOUR NUMBER"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MSISDN"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/inputPhone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/edit_text"
        android:hint="+905390000020"
        android:inputType="phone"
        android:text="+905390000020"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSignIn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Sign in"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#0056B3"
        android:textColor="#FFFFFF"/>

    <!-- Hata ve Log Konteyneri (Başlangıçta Gizli) -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Sign-in failed"
            android:textColor="#DC3545"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8D7DA"
            android:textColor="#721C24"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Connection logs:\n[ERROR] POST /verify\nStatus: 403 Forbidden\nCode: NUMBER_VERIFICATION.USER_NOT_AUTHENTICATED_BY_MOBILE_NETWORK"/>
    </LinearLayout>

</LinearLayout>